NODE_ENV=production
PORT=10000
LOG_LEVEL=info

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

FRONTEND_APP_URL=https://app.seudominio.com
CORS_ORIGIN=https://app.seudominio.com,https://www.app.seudominio.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=replace_after_first_seed
